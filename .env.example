# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file anywhere public.

# Port the app runs on
PORT=3000

# Password required to log in to the app (pick anything you want)
APP_PASSWORD=changeme123

# Random long random string used to secure login sessions (any random text works)
SESSION_SECRET=please-change-this-to-something-random

# ---- Email (SMTP) settings, used to send overdue alerts ----
# Example below is for Gmail using an "App Password" (not your normal Gmail password).
# Google: Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Vendor Tracker <youraddress@gmail.com>"

# What time each day to check for overdue components and send alert emails.
# Uses cron syntax: "minute hour * * *". Default below = 8:00 AM every day.
ALERT_CRON=0 8 * * *

# ---- Database (MongoDB Atlas - free cloud database) ----
# Get this from MongoDB Atlas: Database -> Connect -> Drivers -> copy the
# connection string, then swap in your real username/password.
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Name of the database to use inside that cluster (created automatically if
# it doesn't exist yet - no manual setup needed in Atlas).
MONGODB_DB_NAME=vendor_tracker
